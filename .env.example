# Copy to ~/.ssh/tutalink/.env (outside the repo). Key names only — no real secrets here.
#
# DEPLOY_ARCHITECTURE is normally set in ~/.ssh/be/.env (TutaMall). tutalink deploy
# scripts read it from there. Optionally override here.
#   ALL-IN-ONE      → Xbox2 does everything (or Mac local)
#   MINI_PRODUCTION → xbox1 Primary; tutalink on xbox2 + xbox3
#   FULL_PRODUCTION → later
# DEPLOY_ARCHITECTURE=ALL-IN-ONE

SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=4100

# --- Mac (dev) OR ALL-IN-ONE single-box: primary == replica ---
DB_PRIMARY_URL=jdbc:postgresql://127.0.0.1:50010/outdatedDBOct2021
DB_REPLICA_URL=jdbc:postgresql://127.0.0.1:50010/outdatedDBOct2021

# --- MINI_PRODUCTION examples (set per host; do not commit real values) ---
# On xbox2 / xbox3 webservers:
#   DB_PRIMARY_URL=jdbc:postgresql://192.168.202.201:50010/outdatedDBOct2021
#   DB_REPLICA_URL=jdbc:postgresql://127.0.0.1:50010/outdatedDBOct2021
# On xbox2 ALL-IN-ONE:
#   DB_PRIMARY_URL=jdbc:postgresql://127.0.0.1:50010/outdatedDBOct2021
#   DB_REPLICA_URL=jdbc:postgresql://127.0.0.1:50010/outdatedDBOct2021

DB_USER=tutalink_user
DB_PASSWORD=
REDIS_URL=redis://localhost:6379
TUTALINK_API_KEY=
TUTALINK_BASE_URL=http://localhost:4100/l/
# Ubuntu / production short links:
# TUTALINK_BASE_URL=https://tutamall.com/l/
TUTALINK_IP_SALT=
TUTALINK_LOG_DIR=/Users/a/mac_storage/logs/tutalink
# Ubuntu example:
# TUTALINK_LOG_DIR=${LARGE_CHEAP_STORAGE_FOLDER}/logs/tutalink
